# Copy to backend/.env (or the project root .env) and fill in what you need.
# Every value has a working default; secrets are only ever read from here.

# --- App ---------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: require X-API-Key on every /api call (also set VITE_API_KEY in the frontend)
API_KEY=

# --- Database / storage ------------------------------------------------
# Empty = SQLite file at storage/prevucam.db.  PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://prevucam:secret@localhost:5432/prevucam
DATABASE_URL=
STORAGE_PATH=../storage
MODEL_PATH=../models/yolov8n.pt

# --- Camera ------------------------------------------------------------
# browser = the webcam of the computer viewing the dashboard (Live Monitoring → Start)
# webcam (server-side USB camera) | rtsp | file | picamera
CAMERA_SOURCE_TYPE=browser
# webcam index (0), rtsp://... URL, or a video file name in storage/uploads
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
CAMERA_AUTOSTART=false
CAMERA_LOOP_FILE=true

# --- Motion / detection (defaults – editable at runtime in the UI) ------
MOTION_SENSITIVITY=60
MOTION_MIN_AREA=800
MOTION_THRESHOLD=0
YOLO_CONFIDENCE=0.5
YOLO_IMGSZ=416
DETECTION_INTERVAL=3
RELEVANT_OBJECTS=person,car,motorcycle,bicycle,bus,truck

# --- Events ------------------------------------------------------------
PRE_EVENT_SECONDS=7
POST_EVENT_SECONDS=7
MAX_EVENT_SECONDS=120
EVENT_COOLDOWN_SECONDS=2
LOITERING_SECONDS=20
LOITERING_CLASSES=person

# --- Recorded video analysis -------------------------------------------
MAX_UPLOAD_MB=2048
# Frames wider than this are downscaled for analysis and event clips (speed / disk)
ANALYSIS_MAX_WIDTH=1280

# --- Storage policy ----------------------------------------------------
MAX_STORAGE_GB=10
RETENTION_DAYS=30
AUTO_DELETE_ENABLED=false

# --- Credentials -------------------------------------------------------
# Preferred: put them in backend/config/api_keys.py (git-ignored). Values there override these.

# --- Gemini (event summaries) ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Twilio (SMS / WhatsApp event alerts) ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Telegram (optional) -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM=
ALERT_EMAIL=
