# Leave VITE_API_BASE_URL empty in development: Vite proxies /api, /media and /ws to the backend.
# Set it when the frontend is served separately, e.g. http://192.168.1.50:8000
VITE_API_BASE_URL=
# Backend used by the dev-server proxy
VITE_BACKEND_PROXY=http://127.0.0.1:8000
# Only if the backend has API_KEY set
VITE_API_KEY=
